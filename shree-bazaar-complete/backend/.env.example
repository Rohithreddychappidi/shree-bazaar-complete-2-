# --- Database ---
# FOR TESTING NOW: use a free Neon Postgres project (https://neon.tech) — takes ~2 minutes
# to create. Neon gives you TWO connection strings on the dashboard:
#   - a pooled one (hostname contains "-pooler") → use for DATABASE_URL (the app at runtime)
#   - a direct one (no "-pooler") → use for DIRECT_URL (Prisma migrations need this one)
# Both need `?sslmode=require` at the end.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# WHEN YOU DEPLOY: switch both of the above to your self-hosted VPS Postgres instead —
# same format, just USER:PASSWORD@localhost:5432/shreebazaar with no sslmode needed
# (or sslmode=disable). Nothing else in the code changes; Prisma just points elsewhere.

# --- Server ---
PORT=4000
NODE_ENV=production

# --- Frontend origin (for CORS + post-login redirect) ---
FRONTEND_URL="http://localhost:3000"

# --- Auth ---
JWT_SECRET="replace-with-a-long-random-string"
COOKIE_SECURE=true

# --- Google OAuth ---
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"

# --- Razorpay (server-side only — never expose the secret to the frontend) ---
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
# From Razorpay Dashboard → Settings → Webhooks, after you add the webhook URL
# (https://api.yourdomain.com/api/webhooks/razorpay) and set a secret there.
RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"

# --- Making yourself an admin ---
# There's no invite/promotion UI yet. Sign in once via Google on the frontend first (this
# creates your user row as role=CUSTOMER), then set this to your email and rerun
# `npm run prisma:seed` — it will promote that user to ADMIN. Leave blank to skip.
SEED_ADMIN_EMAIL=""

# --- Shiprocket ---
# Use a dedicated API user (Shiprocket panel → Settings → API → Configure → Create API
# User), NOT your main account login.
SHIPROCKET_EMAIL="your-api-user-email@example.com"
SHIPROCKET_PASSWORD="your-api-user-password"
# Shiprocket requires a billing email per order; used as a fallback if a customer
# somehow has no email on file (shouldn't normally happen with Google accounts).
SHIPROCKET_FALLBACK_EMAIL="orders@yourdomain.com"
# NOTE: the default/fallback pickup location is now set at /admin/settings (Shipping →
# Default Pickup Location), not here — individual products can also override it with
# their own pickup location for multi-warehouse setups. See backend/README.md.

# --- WhatsApp (Meta Cloud API) ---
# Requires: a Meta Business Account + WhatsApp Business Account (WABA), a verified
# WhatsApp business phone number, a PERMANENT access token (via a System User in Meta
# Business Suite — not the 24h temporary token from the developer console), and message
# templates created + approved by Meta before any of this can actually send. See
# backend/README.md for the full explanation. Leave blank to leave WhatsApp disabled —
# nothing else in the app breaks if these aren't set.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v22.0"
WHATSAPP_TEMPLATE_LANGUAGE="en"
# Names of your approved templates in Meta Business Manager — must match exactly.
WHATSAPP_TEMPLATE_ORDER_PLACED=""
WHATSAPP_TEMPLATE_ORDER_STATUS_UPDATE=""
WHATSAPP_TEMPLATE_ORDER_CANCELLED=""
